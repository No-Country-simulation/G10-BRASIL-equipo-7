# Copie para .env e preencha. NUNCA commite o .env nem compartilhe a chave no chat.
# Múltiplas chaves separadas por vírgula.
GEMINI_API_KEYS=
# Chave única.
# No modo mock, GEMINI_API_KEY e as configurações OCI podem ficar vazios.
GEMINI_API_KEY=

API_URL=http://localhost:8000

# Armazenamento: local grava em disco; oci grava nos buckets do OCI Object Storage
STORAGE_MODE=local
STORAGE_LOCAL_DIR=.local/storage

# Agente: mock funciona sem Gemini; real depende da implementação do grafo
AGENT_MODE=mock

# Segundos por tentativa; em falha técnica, o agente é chamado mais uma vez.
AGENT_TIMEOUT_SECONDS=30

# OCI Object Storage pela API compatível com S3 (usado com STORAGE_MODE=oci)
# Credenciais: Customer Secret Key do usuário da OCI (Access Key e Secret Key).
OCI_NAMESPACE=
OCI_REGION=sa-saopaulo-1
OCI_S3_ACCESS_KEY=
OCI_S3_SECRET_KEY=
# Opcional: substitui o endpoint montado com o namespace e a região.
OCI_S3_ENDPOINT=
OCI_BUCKET_RECEBIDOS=mediflow-recebidos
OCI_BUCKET_PROCESSADOS=mediflow-processados
OCI_BUCKET_AUDITORIA=mediflow-auditoria-humana

# Alerta de urgencia (n8n / webhook)
ALERTA_WEBHOOK_URL=
