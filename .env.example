# Copie para .env e preencha. NUNCA commite o .env nem compartilhe a chave no chat.
GEMINI_API_KEY=
API_URL=http://localhost:8000

# Armazenamento local (simula os buckets até a integração OCI)
STORAGE_LOCAL_DIR=.local/storage

# OCI Object Storage
OCI_CONFIG_FILE=~/.oci/config
OCI_NAMESPACE=
OCI_BUCKET_RECEBIDOS=recebidos
OCI_BUCKET_PROCESSADOS=processados
OCI_BUCKET_AUDITORIA=auditoria-humana

# Alerta de urgencia (n8n / webhook)
ALERTA_WEBHOOK_URL=
